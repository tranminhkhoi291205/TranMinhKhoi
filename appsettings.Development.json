{
  // CHỈ dùng khi phát triển: trả mã OTP trong phản hồi API (trường devOtp) để test mà không cần gửi email thật.
  // Khi nộp bài / chạy thật hãy đặt false và cấu hình mục "Email" trong appsettings.json
  "Otp": {
    "ReturnOtpInResponse": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
