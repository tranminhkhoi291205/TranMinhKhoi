  "Email": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "User": "",
    "Password": "",
    "From": ""
  },

  // Ngưỡng giống nhau (cosine) để chấp nhận khuôn mặt khi chấm công
  "Face": {
    "Threshold": 0.8
  },

  // Tài khoản mẫu được tạo khi chạy lần đầu
  "Seed": {
    "AdminUsername": "admin",
    "AdminEmail": "admin@trankhoi.local",
    "AdminPassword": "Admin@123"
  },

  "Logging": {
