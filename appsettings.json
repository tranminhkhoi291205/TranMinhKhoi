{
  "ConnectionStrings": {
    // Đổi tên máy chủ SQL Server cho đúng máy của bạn (nếu SQL Server của bạn là bản Express thì dùng LAPTOP-35G8KQ3J\\SQLEXPRESS)
    "DefaultConnection": "Server=LAPTOP-35G8KQ3J;Database=TranMinhKhoi;Trusted_Connection=True;TrustServerCertificate=True"
  },

  // Khóa ký JWT (tối thiểu 32 ký tự)
  "JWTKey": {
    "Secret": "TranMinhKhoi_ChamCong_JWT_SecretKey_2026_DoDaiTren32KyTu!",
    "ValidIssuer": "TranMinhKhoiAPI",
    "ValidAudience": "TranMinhKhoiApp",
    "TokenExpiryTimeInHour": "8"
  },

  // OTP gửi qua email
  "Otp": {
    "ExpiryMinutes": 5,
    "ReturnOtpInResponse": false
  },

  // Cấu hình gửi email (ví dụ Gmail: smtp.gmail.com, cổng 587, dùng "Mật khẩu ứng dụng" 16 ký tự)
